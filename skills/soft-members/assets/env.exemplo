# Soft Members: copie este arquivo para .env e preencha tudo.
#   cp .env.exemplo .env
# Depois rode: bash checar_env.sh

# E-mail do dono da area de membros. Vira o super admin no primeiro boot.
# Se ficar vazio, o processo do app morre na primeira visita (process.exit(1)).
SUPER_ADMIN_EMAIL=

# Segredo que assina a sessao. Gere um novo com: openssl rand -hex 32
# Trocar este valor derruba todo mundo que estava logado.
AUTH_SECRET=

# Endereco do banco. Com o mongo deste compose, o host e o nome do servico (mongo).
# Troque usuario e senha se mudar MONGO_USER e MONGO_PASS.
DB_CONNECTION_STRING=

# Mongo avulso nao faz transacao. Mantenha false neste compose.
DB_TRANSACTIONS=false

# Servidor de SMTP que envia o codigo de acesso e o link de senha.
EMAIL_HOST=

# Porta do SMTP. Costuma ser 587 com TLS, ou 465 com SSL.
EMAIL_PORT=587

# Usuario do SMTP, quase sempre o proprio e-mail da conta de envio.
EMAIL_USER=

# Senha do SMTP, ou a senha de aplicativo quando o provedor exige.
EMAIL_PASS=

# Remetente que o aluno ve na caixa de entrada. Exemplo: Escola <contato@seudominio.com.br>
EMAIL_FROM=

# Um dono por instalacao. Manter true amarra a cobranca ao SaaS oficial.
MULTITENANT=false

# Modo de producao. Fora de producao o e-mail cai no log em vez de ser enviado.
NODE_ENV=production

# Dominio da area de membros, sem http. Exemplo: membros.seudominio.com.br
# Precisa ter registro A apontando para o IP desta VPS.
DOMINIO=

# Imagem ja presente na VPS ou publicada em um registry acessivel pelo cliente.
SOFT_MEMBERS_IMAGE=soft-members:local

# Usuario e senha do mongo deste compose. Nunca reutilize o exemplo.
MONGO_USER=
MONGO_PASS=

# Endereco interno do proprio app. Deixe como esta.
SOFT_INTERNAL_URL=http://127.0.0.1:8080

# A Soft Members e uma area de membros pura, sem vitrine nem checkout publico.
SOFT_MEMBERS_DISABLE_COMMERCE=true

# Arquivos enviados sem MediaLit ficam neste volume persistente do container.
MEDIA_STORAGE_PATH=/data/media

# Limite por imagem em bytes. O padrao abaixo equivale a 10 MB.
MEDIA_UPLOAD_MAX_BYTES=10485760
